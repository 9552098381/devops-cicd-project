pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Java application...'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing Java application...'
            }
        }
    }
}
